# CrytoBot Environment Variables Example
# Kopyalayıp .env olarak kaydedin ve gerçek değerlerinizi girin.
# Güvenlik Kuralı: API anahtarında yalnızca okuma ve spot işlem yetkisi olmalıdır.
# PARA ÇEKME (WITHDRAWAL) YETKİSİ KESİNLİKLE KAPALI OLMALIDIR (fail-closed koruması vardır).

# Binance Spot Live Modu için API Anahtarları
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Binance Spot Testnet Modu için API Anahtarları
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_binance_testnet_api_secret_here
